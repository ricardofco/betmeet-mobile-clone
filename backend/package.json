{
  "name": "betmeet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone backend for BetmeetMobile — mobile-only, independent from betmeet-clone (ADR-026). See memory-bank/bolts/bolt-backend-phase1/.",
  "type": "commonjs",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:competition": "tsx src/scripts/seed-competition.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.110.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
