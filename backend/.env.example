# --- Postgres (Supabase project → Settings → Database) ---
# Pooled connection (transaction pooler) — used at runtime by Prisma Client.
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection — used by Prisma CLI (migrate/studio).
DIRECT_URL="postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase (Settings → API) — same project as mobile's SUPABASE_URL ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Bypasses RLS — used only for Storage signed-upload URLs (avatar upload). Never sent to mobile.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage bucket for user-uploaded avatars (created manually in the Supabase dashboard).
AVATAR_STORAGE_BUCKET="avatars"

PORT="4000"
NODE_ENV="development"
