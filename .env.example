# Copy to `.env` (git-ignored) and fill in real values for your Supabase
# project + backend API before running a real sign-in flow.
# Read at native-build time by `react-native-config` (see
# src/platform/supabase/config.ts, src/platform/backend-api/backend-api-client.ts).

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend API base URL (system-context.md §3) — hosting location still TBD.
BACKEND_API_BASE_URL=
